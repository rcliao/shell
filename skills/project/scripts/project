#!/bin/sh
# project — project registry: create, list, get (P1)
set -e

SOCK="${SHELL_BRIDGE_SOCK:-$HOME/.shell/bridge.sock}"
URL="http://bridge/project"
CHAT_ID="${SHELL_CHAT_ID:-0}"

usage() {
  echo "usage: project create --title <text> [--emoji <e> --chat <id> --thread <id> --export-ref <id> --doc-path <path> --instructions <text> --lang <code> --cadence daily|weekly|monthly]" >&2
  echo "                        [--area <area slug> --place auto --stage <stage> --content <first message>]   (a project in an area)" >&2
  echo "                        [--kind area --place new [--channel-name N --forum-name F --tags a,b,c]]     (an area with its own channel + forum)" >&2
  echo "       project join --thread <post id>   (track another agent's post as your own project)" >&2
  echo "       project move <slug> --area <area slug> [--stage <stage> --place auto --content <first message>]" >&2
  echo "       project stage <slug> --stage <stage>" >&2
  echo "       project archive <slug>" >&2
  echo "       project list [--chat <id>]" >&2
  echo "       project get <slug>" >&2
  echo "       project doc-read <slug>" >&2
  echo "       project doc-write <slug> [--file <path>] [--attribution <text>] [--confirm-shrink]   (content from --file or stdin; the doc's text only)" >&2
  exit 1
}

VERB="$1"
[ -n "$VERB" ] || usage
shift

TITLE=""
EMOJI=""
THREAD=""
EXPORT_REF=""
DOC_PATH=""
INSTRUCTIONS=""
LANG_CODE=""
CADENCE=""
SLUG=""
FILE=""
ATTRIBUTION=""
CHAT_EXPLICIT=""
KIND=""
PLACE_REF=""
AREA=""
PLACE=""
STAGE=""
CONTENT=""
CHANNEL_NAME=""
FORUM_NAME=""
TAGS=""
CONFIRM_SHRINK=""

while [ $# -gt 0 ]; do
  case "$1" in
    --title)        TITLE="$2"; shift 2 ;;
    --emoji)        EMOJI="$2"; shift 2 ;;
    --chat)         CHAT_ID="$2"; CHAT_EXPLICIT=1; shift 2 ;;
    --thread)       THREAD="$2"; shift 2 ;;
    --export-ref)   EXPORT_REF="$2"; shift 2 ;;
    --doc-path)     DOC_PATH="$2"; shift 2 ;;
    --instructions) INSTRUCTIONS="$2"; shift 2 ;;
    --lang)         LANG_CODE="$2"; shift 2 ;;
    --cadence)      CADENCE="$2"; shift 2 ;;
    --file)         FILE="$2"; shift 2 ;;
    --attribution)  ATTRIBUTION="$2"; shift 2 ;;
    --kind)         KIND="$2"; shift 2 ;;
    --place-ref)    PLACE_REF="$2"; shift 2 ;;
    --area)         AREA="$2"; shift 2 ;;
    --place)        PLACE="$2"; shift 2 ;;
    --stage)        STAGE="$2"; shift 2 ;;
    --content)      CONTENT="$2"; shift 2 ;;
    --channel-name) CHANNEL_NAME="$2"; shift 2 ;;
    --forum-name)   FORUM_NAME="$2"; shift 2 ;;
    --tags)         TAGS="$2"; shift 2 ;;
    --confirm-shrink) CONFIRM_SHRINK=1; shift ;;
    --*)            echo "unknown arg: $1" >&2; usage ;;
    *)              SLUG="$1"; shift ;;
  esac
done

post() {
  RESP=$(curl -s --unix-socket "$SOCK" "$URL" -X POST -H "Content-Type: application/json" -d "$1")
  if [ -z "$RESP" ]; then
    echo "no response from bridge — is the daemon running?" >&2
    exit 1
  fi
  if printf '%s\n' "$RESP" | grep -q '"error"'; then
    printf '%s\n' "$RESP" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error',''))" 2>/dev/null || printf '%s\n' "$RESP"
    exit 1
  fi
}

case "$VERB" in
  create)
    if [ -z "$TITLE" ]; then
      echo "create requires --title" >&2
      exit 1
    fi
    # A project in an area lives in the area's chat: leave chat_id to the
    # server unless --chat was given.
    if [ -n "$AREA" ] && [ -z "$CHAT_EXPLICIT" ]; then CHAT_ID=0; fi
    BODY=$(TITLE="$TITLE" EMOJI="$EMOJI" CHAT_ID="$CHAT_ID" THREAD="$THREAD" \
      EXPORT_REF="$EXPORT_REF" DOC_PATH="$DOC_PATH" INSTRUCTIONS="$INSTRUCTIONS" \
      LANG_CODE="$LANG_CODE" CADENCE="$CADENCE" KIND="$KIND" PLACE_REF="$PLACE_REF" \
      AREA="$AREA" PLACE="$PLACE" STAGE="$STAGE" CONTENT="$CONTENT" \
      CHANNEL_NAME="$CHANNEL_NAME" FORUM_NAME="$FORUM_NAME" TAGS="$TAGS" python3 -c "
import json, os
d = {'action': 'create', 'title': os.environ['TITLE'], 'chat_id': int(os.environ['CHAT_ID'] or 0)}
for k in ('kind', 'place_ref', 'area', 'place', 'stage', 'content', 'channel_name', 'forum_name'):
    if os.environ[k.upper()]: d[k] = os.environ[k.upper()]
if os.environ['TAGS']: d['tags'] = [t.strip() for t in os.environ['TAGS'].split(',') if t.strip()]
if os.environ['EMOJI']: d['emoji'] = os.environ['EMOJI']
if os.environ['THREAD']: d['message_thread_id'] = int(os.environ['THREAD'])
if os.environ['EXPORT_REF']: d['export_ref'] = os.environ['EXPORT_REF']
if os.environ['DOC_PATH']: d['doc_path'] = os.environ['DOC_PATH']
if os.environ['INSTRUCTIONS']: d['instructions'] = os.environ['INSTRUCTIONS']
if os.environ['LANG_CODE']: d['lang'] = os.environ['LANG_CODE']
if os.environ['CADENCE']: d['cadence'] = os.environ['CADENCE']
print(json.dumps(d))
")
    post "$BODY"
    # Read-back receipt: print what the SERVER stored, warning included.
    printf '%s\n' "$RESP" | python3 -c "
import sys, json
r = json.load(sys.stdin)
print(f\"Project {r['slug']} {'created' if r.get('created', True) else 'already exists'} ({r['status']}), chat {r['chat_id']}\")
if r.get('emoji'): print(f\"  emoji: {r['emoji']}\")
if r.get('export_ref'): print(f\"  export: {r.get('export_kind','')}:{r['export_ref']}\")
if r.get('doc_path'): print(f\"  doc: {r['doc_path']}\")
if r.get('instructions'): print(f\"  instructions: {r['instructions']}\")
print(f\"  ghost tag: {r['ghost_tag']}\")
if r.get('cadence'): print(f\"  research cadence: {r['cadence']}\")
if r.get('kind') == 'area': print(f\"  area; places: {r.get('place_ref') or '(none)'}\")
if r.get('area'): print(f\"  in area: {r['area']}\")
if r.get('stage'): print(f\"  stage: {r['stage']}\")
if r.get('message_thread_id'): print(f\"  thread: {r['message_thread_id']}\" + (' (place created)' if r.get('place_created') else '') + (' (joined the existing post)' if r.get('place_joined') else ''))
if r.get('channel_mention'): print(f\"  channel: {r['channel_mention']}  forum: {r.get('forum_mention','')}\" + (' (created now)' if r.get('places_created') else ' (already existed)'))
if r.get('warning'): print(f\"  WARNING: {r['warning']}\")
if r.get('place_warning'): print(f\"  PLACE NOT CREATED: {r['place_warning']}\")
" 2>/dev/null || printf '%s\n' "$RESP"
    ;;

  join)
    if [ -z "$THREAD" ]; then
      echo "join requires --thread <post id>" >&2
      exit 1
    fi
    BODY=$(CHAT_ID="$CHAT_ID" THREAD="$THREAD" STAGE="$STAGE" python3 -c "
import json, os
d = {'action': 'join', 'chat_id': int(os.environ['CHAT_ID'] or 0), 'message_thread_id': int(os.environ['THREAD'])}
if os.environ['STAGE']: d['stage'] = os.environ['STAGE']
print(json.dumps(d))
")
    post "$BODY"
    printf '%s\n' "$RESP" | python3 -c "
import sys, json
r = json.load(sys.stdin)
if r.get('joined'):
    print(f\"Project {r['slug']} joined: thread {r['message_thread_id']}, area {r.get('area','')}\" + (f\", stage {r['stage']}\" if r.get('stage') else ''))
else:
    print(r.get('result') or f\"Project {r['slug']} (already tracked)\")
if r.get('doc_path'): print(f\"  doc: {r['doc_path']}\")
if r.get('warning'): print(f\"  WARNING: {r['warning']}\")
" 2>/dev/null || printf '%s\n' "$RESP"
    ;;

  move|stage|archive)
    if [ -z "$SLUG" ]; then
      echo "$VERB requires a slug" >&2
      exit 1
    fi
    if [ "$VERB" = "move" ] && [ -z "$AREA" ]; then
      echo "move requires --area (--area '' is not supported here; use the CLI)" >&2
      exit 1
    fi
    if [ "$VERB" = "stage" ] && [ -z "$STAGE" ]; then
      echo "stage requires --stage" >&2
      exit 1
    fi
    BODY=$(VERB="$VERB" SLUG="$SLUG" AREA="$AREA" PLACE="$PLACE" STAGE="$STAGE" CONTENT="$CONTENT" python3 -c "
import json, os
v = os.environ['VERB']
d = {'action': 'status' if v == 'archive' else v, 'slug': os.environ['SLUG']}
if v == 'archive': d['status'] = 'archived'
for k in ('area', 'place', 'stage', 'content'):
    if os.environ[k.upper()]: d[k] = os.environ[k.upper()]
print(json.dumps(d))
")
    post "$BODY"
    printf '%s\n' "$RESP" | python3 -c "
import sys, json
r = json.load(sys.stdin)
print(f\"Project {r['slug']} ({r['status']})\" + (f\" in area {r['area']}\" if r.get('area') else '') + (f\", stage {r['stage']}\" if r.get('stage') else ''))
if r.get('message_thread_id'): print(f\"  thread: {r['message_thread_id']}\" + (' (place created)' if r.get('place_created') else '') + (' (joined the existing post)' if r.get('place_joined') else ''))
if r.get('channel_mention'): print(f\"  channel: {r['channel_mention']}  forum: {r.get('forum_mention','')}\" + (' (created now)' if r.get('places_created') else ' (already existed)'))
if r.get('warning'): print(f\"  WARNING: {r['warning']}\")
if r.get('place_warning'): print(f\"  PLACE NOT CREATED: {r['place_warning']}\")
" 2>/dev/null || printf '%s\n' "$RESP"
    ;;

  list)
    post "{\"action\": \"list\", \"chat_id\": $CHAT_ID}"
    printf '%s\n' "$RESP" | python3 -c "
import sys, json
r = json.load(sys.stdin)
projects = r.get('projects', [])
if not projects:
    print('No projects.')
for p in projects:
    emoji = (p.get('emoji') + ' ') if p.get('emoji') else ''
    export = f\" | {p['export_kind']}:{p['export_ref']}\" if p.get('export_ref') else ''
    kind = ' (area)' if p.get('kind') == 'area' else ''
    area = f\" | in {p['area']}\" if p.get('area') else ''
    stage = f\" | {p['stage']}\" if p.get('stage') else ''
    print(f\"{emoji}{p['slug']} [{p['status']}]{kind} — {p['title']}{area}{stage}{export}\")
" 2>/dev/null || printf '%s\n' "$RESP"
    ;;

  set-instructions)
    if [ -z "$SLUG" ]; then
      echo "set-instructions requires a slug and --instructions" >&2
      exit 1
    fi
    BODY=$(SLUG="$SLUG" INSTR="$INSTRUCTIONS" python3 -c "import json, os; print(json.dumps({'action': 'set-instructions', 'slug': os.environ['SLUG'], 'instructions': os.environ['INSTR']}))")
    post "$BODY"
    printf '%s\n' "$RESP" | python3 -m json.tool 2>/dev/null || printf '%s\n' "$RESP"
    ;;

  get)
    if [ -z "$SLUG" ]; then
      echo "get requires a slug" >&2
      exit 1
    fi
    BODY=$(SLUG="$SLUG" python3 -c "import json, os; print(json.dumps({'action': 'get', 'slug': os.environ['SLUG']}))")
    post "$BODY"
    printf '%s\n' "$RESP" | python3 -m json.tool 2>/dev/null || printf '%s\n' "$RESP"
    ;;

  doc-read)
    if [ -z "$SLUG" ]; then
      echo "doc-read requires a slug" >&2
      exit 1
    fi
    BODY=$(SLUG="$SLUG" python3 -c "import json, os; print(json.dumps({'action': 'doc-read', 'slug': os.environ['SLUG']}))")
    post "$BODY"
    # Doc content, prefixed with the rev it was served at.
    printf '%s\n' "$RESP" | python3 -c "
import sys, json
r = json.load(sys.stdin)
print(f\"rev {r['rev']} ({r['doc_path']})\")
print(r['content'])
" 2>/dev/null || printf '%s\n' "$RESP"
    ;;

  doc-write)
    if [ -z "$SLUG" ]; then
      echo "doc-write requires a slug" >&2
      exit 1
    fi
    if [ -n "$FILE" ]; then
      [ -r "$FILE" ] || { echo "cannot read --file $FILE" >&2; exit 1; }
      CONTENT_SRC="$FILE"
    else
      CONTENT_SRC="-"  # stdin
    fi
    BODY=$(SLUG="$SLUG" ATTRIBUTION="$ATTRIBUTION" CONTENT_SRC="$CONTENT_SRC" CONFIRM_SHRINK="$CONFIRM_SHRINK" python3 -c "
import json, os, sys
src = os.environ['CONTENT_SRC']
content = sys.stdin.read() if src == '-' else open(src, encoding='utf-8').read()
d = {'action': 'doc-write', 'slug': os.environ['SLUG'], 'content': content}
if os.environ['ATTRIBUTION']: d['attribution'] = os.environ['ATTRIBUTION']
if os.environ['CONFIRM_SHRINK']: d['confirm_shrink'] = True
print(json.dumps(d))
")
    post "$BODY"
    # Read-back receipt: the commit hash the server minted for this write.
    printf '%s\n' "$RESP" | python3 -c "
import sys, json
r = json.load(sys.stdin)
print(f\"Doc {r['slug']} committed: rev {r['rev']}\")
" 2>/dev/null || printf '%s\n' "$RESP"
    ;;

  *)
    usage
    ;;
esac
