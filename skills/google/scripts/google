#!/bin/sh
# google — Google Workspace access (docs, sheets, calendar, drive, tasks)
# via the gog CLI. Handles account selection so callers never deal with auth:
# invoke this wrapper, NOT gog directly.
set -e

if ! command -v gog >/dev/null 2>&1; then
  echo "gog CLI not installed (brew install gogcli)" >&2
  exit 1
fi

# Account can be overridden per-agent via config env; defaults to the
# household service account.
: "${GOG_ACCOUNT:=pikamini.golden@gmail.com}"
export GOG_ACCOUNT

# Tokens live in gog's password-protected file keyring (the macOS keychain
# is not accessible from headless daemon subprocesses). The password file is
# host-local and untracked.
if [ -f "$HOME/.shell/gog-keyring-pass" ]; then
  GOG_KEYRING_BACKEND=file
  GOG_KEYRING_PASSWORD="$(cat "$HOME/.shell/gog-keyring-pass")"
  export GOG_KEYRING_BACKEND GOG_KEYRING_PASSWORD
fi

exec gog --no-input "$@"
